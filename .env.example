# Demo/runtime configuration
SKILLTRACK_DB=backend/skilltrack.db
DATABASE_URL=sqlite:///./backend/skilltrack.db
JWT_SECRET=replace-with-a-random-secret
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
CORS_ORIGINS=http://localhost:5173,http://localhost:8000
ENVIRONMENT=demo
PORT=8000

# Optional live AI providers. Leave empty for the offline deterministic demo.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
